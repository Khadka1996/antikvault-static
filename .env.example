# Copy to .env.local for local development, or set these in your hosting
# provider's project settings for production. All are optional — the app has
# sane defaults and simply omits a feature (e.g. GA4) if its variable is unset.
# Remember: this is a static export, so env vars are baked in at BUILD time —
# changing one requires a rebuild + redeploy, not just a server restart.

# Production site URL, used for canonical URLs, sitemap.xml, robots.txt,
# Open Graph/Twitter metadata, and JSON-LD. Defaults to https://antikvault.com
# (see src/config/site.js) if unset.
NEXT_PUBLIC_APP_URL=https://antikvault.com

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Leave unset to skip Google Analytics
# entirely — src/components/GoogleAnalytics.js renders nothing without it.
NEXT_PUBLIC_GA_ID=
